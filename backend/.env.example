# Ollama server (default assumes Ollama running locally on Windows)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# CORS - the Vite dev server origin
FRONTEND_ORIGIN=http://localhost:5173

# Razorpay Test Mode. Leave empty to use the built-in stub payment gateway.
# Generate real Test Mode keys at: Razorpay Dashboard -> Test Mode ->
# Account & Settings -> API Keys -> Generate Key (no business verification
# needed for test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
